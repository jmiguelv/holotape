filters:
  and:
    - file.inFolder("Projects")
    - file.ext == "md"
    - file.basename.startsWith("Project - ")
views:
  - type: table
    name: All projects
    order:
      - file.name
      - status
      - priority
      - leads
    sort:
      - property: priority
        direction: ASC
    columnSize:
      file.name: 265
      note.status: 132
      note.priority: 151
